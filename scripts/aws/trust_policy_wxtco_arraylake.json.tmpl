{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::<EARTHMOVER_SIGNER_ACCOUNT_ID>:root"},
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {"sts:ExternalId": "${EXTERNAL_ID}"},
        "ArnLike": {"aws:PrincipalArn": "arn:aws:iam::<EARTHMOVER_SIGNER_ACCOUNT_ID>:role/EarthmoverSignerServiceRole-production"}
      }
    },
    {
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::<EARTHMOVER_SIGNER_ACCOUNT_ID>:root"},
      "Action": "sts:TagSession",
      "Condition": {
        "ArnLike": {"aws:PrincipalArn": "arn:aws:iam::<EARTHMOVER_SIGNER_ACCOUNT_ID>:role/EarthmoverSignerServiceRole-production"}
      }
    }
  ]
}
