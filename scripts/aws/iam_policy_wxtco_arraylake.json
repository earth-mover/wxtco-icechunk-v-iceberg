{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::em-tco-mogreps"
    },
    {
      "Sid": "ArraylakeStorageReadWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:PutObjectAcl", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::em-tco-mogreps/arraylake/*"
    },
    {
      "Sid": "NetcdfReadOnlyForVirtualChunks",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::em-tco-mogreps/netcdf/*"
    }
  ]
}
